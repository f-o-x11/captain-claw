<?xml version="1.0" encoding="utf-8"?>
<!-- A kiosk card: rounded-xl, zinc-800 border, zinc-900/60. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1FFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/card" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</ripple>
