<?xml version="1.0" encoding="utf-8"?>
<!-- The start screen (DecksActivity): the saved Flight Decks, adding one, and
     signing in — one page at a time, drawn like the kiosk's phone layout. The
     root takes the system-bar / keyboard insets as padding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/decks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Header: h-14, border-b zinc-800, the brand mark on the left. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_chevron_left"
            android:tint="@color/text_dim"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_art" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/header_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/decks_caption"
                android:textColor="@color/text_faint"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── The decks ── -->
        <ScrollView
            android:id="@+id/page_list"
            android:defaultFocusHighlightEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/list_label"
                    style="@style/Kiosk.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/list_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_panel"
                    android:padding="14dp"
                    android:textColor="@color/error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/list_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="4dp"
                    android:lineSpacingMultiplier="1.15"
                    android:text="@string/decks_note"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ── Add a deck ── -->
        <ScrollView
            android:id="@+id/page_add"
            android:defaultFocusHighlightEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_tile"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:src="@drawable/ic_server"
                        android:tint="@color/accent_soft" />

                    <TextView
                        android:id="@+id/add_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/add_title"
                        android:textColor="@color/text"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/add_text"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Kiosk.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:labelFor="@+id/address"
                        android:text="@string/deck_label" />

                    <LinearLayout
                        style="@style/Kiosk.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_globe"
                            android:tint="@color/text_faint" />

                        <EditText
                            android:id="@+id/address"
                            style="@style/Kiosk.FieldInput"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:hint="@string/deck_hint"
                            android:imeOptions="actionGo"
                            android:inputType="textUri" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/deck_help"
                        android:textColor="@color/text_faint"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/add_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
            android:id="@+id/add_continue"
            android:layout_width="match_parent"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_height="52dp"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/add_continue_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/add_continue"
                android:textColor="@color/accent_ink"
                android:textSize="16sp" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/accent_ink" />
        </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ── Sign in ── -->
        <ScrollView
            android:id="@+id/page_sign_in"
            android:defaultFocusHighlightEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/sign_in_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/sign_in_deck"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:singleLine="true"
                                android:textColor="@color/text"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/sign_in_host"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:singleLine="true"
                                android:textColor="@color/text_faint"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/sign_in_title"
                        android:textColor="@color/text"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/sign_in_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_dim"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/Kiosk.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:labelFor="@+id/email"
                        android:text="@string/email" />

                    <LinearLayout
                        style="@style/Kiosk.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_mail"
                            android:tint="@color/text_faint" />

                        <EditText
                            android:id="@+id/email"
                            style="@style/Kiosk.FieldInput"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:autofillHints="emailAddress"
                            android:hint="@string/email_hint"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="yes"
                            android:inputType="textEmailAddress" />
                    </LinearLayout>

                    <TextView
                        style="@style/Kiosk.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:labelFor="@+id/password"
                        android:text="@string/password" />

                    <LinearLayout
                        style="@style/Kiosk.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/text_faint" />

                        <EditText
                            android:id="@+id/password"
                            style="@style/Kiosk.FieldInput"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:autofillHints="password"
                            android:hint="@string/password_hint"
                            android:imeOptions="actionGo"
                            android:importantForAutofill="yes"
                            android:inputType="textPassword" />

                        <ImageButton
                            android:id="@+id/password_toggle"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/show_password"
                            android:src="@drawable/ic_eye"
                            android:tint="@color/text_faint" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/remember_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_key"
                            android:tint="@color/accent_soft" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/remember"
                                android:textColor="@color/text"
                                android:textSize="15sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:lineSpacingMultiplier="1.1"
                                android:text="@string/remember_detail"
                                android:textColor="@color/text_faint"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/remember"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:contentDescription="@string/remember" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/sign_in_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
            android:id="@+id/sign_in"
            android:layout_width="match_parent"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_height="52dp"
            android:layout_marginTop="16dp">
            <TextView
                android:id="@+id/sign_in_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sign_in"
                android:textColor="@color/accent_ink"
                android:textSize="16sp" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/accent_ink" />
        </LinearLayout>

                    <Button
                        android:id="@+id/sign_in_web"
                        style="@style/Kiosk.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sign_in_web" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- The list's one action, as the kiosk's "New agent". -->
    <LinearLayout
            android:id="@+id/add"
            android:layout_width="match_parent"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_plus"
                android:tint="@color/accent_ink" />
            <TextView
                android:id="@+id/add_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="0dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/add_deck"
                android:textColor="@color/accent_ink"
                android:textSize="17sp" />
        </LinearLayout>
</LinearLayout>
